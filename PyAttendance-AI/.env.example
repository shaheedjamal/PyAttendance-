# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-32-byte-random-hex-secret

# Database (PostgreSQL for production, SQLite fallback for local Windows development)
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/pyattendance_ai
DATABASE_URL=sqlite:///pyattendance_dev.db

# AES-256 / Fernet key for encrypting stored facial embeddings (base64 32-byte key)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIOMETRIC_ENCRYPTION_KEY=

# AI Face Detection & Recognition Configuration
FACE_DETECTOR_BACKEND=haar
RECOGNITION_COSINE_THRESHOLD=0.62
UNCERTAIN_LOWER_THRESHOLD=0.48

# Institutional Rules
SHORTAGE_THRESHOLD_PERCENT=75.0
BIOMETRIC_RETENTION_DAYS=365

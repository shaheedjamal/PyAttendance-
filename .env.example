# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC key for signing HTTP-only session tokens.
SESSION_SECRET="change-me-in-production-use-32-plus-random-bytes"

# BIOMETRIC_ENCRYPTION_KEY: 32-byte key (hex or UTF-8) for AES-256-GCM encryption of facial embeddings.
BIOMETRIC_ENCRYPTION_KEY="change-me-in-production-biometric-aes256-key"

# DATABASE_URL: Optional path for SQLite database (defaults to ./data/pyattendance.db).
DATABASE_PATH="./data/pyattendance.db"
